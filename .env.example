# Telegram bot token from @BotFather
BOT_TOKEN=

# Comma-separated Telegram user IDs (or a single group chat ID) that receive
# order notifications and can approve/reject/quote/deliver orders.
# Get your numeric user id from @userinfobot.
ADMIN_CHAT_IDS=

# Supabase project (Settings -> API)
SUPABASE_URL=
# Use the SERVICE ROLE key, not the anon key: the bot is a trusted backend
# and needs to bypass RLS to read/write orders for any user.
SUPABASE_SERVICE_ROLE_KEY=

# Path to a local image file with your payment QR code (bank/e-wallet/QRIS).
PAYMENT_QR_IMAGE_PATH=./assets/payment-qr.png
# Free-text shown under the QR (account name, bank, notes).
PAYMENT_INSTRUCTIONS="Transfer to Bank XXX, Account Name: Your Name, Account No: 000-000-000"

# Percentage markup added on top of the scraped price to cover fees/margin
# (used for the manual-quote fallback flow, e.g. G2A links).
SERVICE_FEE_PERCENT=8
# Flat USD markup added on top of a catalog product's G2G price.
CATALOG_MARKUP_USD=1
DEFAULT_CURRENCY=USD

# Optional: HTTP/HTTPS proxy for the scraper (e.g. residential proxy),
# needed because G2A blocks most datacenter IPs outright. Format:
# http://user:pass@host:port
SCRAPER_PROXY_URL=

# Optional, used by the auto-fill path in scripts/g2a-login.ts. Set both to
# skip manual login — npm run login:g2a will fill and submit G2A's login
# form for you (you may still need to solve a CAPTCHA/2FA prompt by hand).
# Leave both unset to log in manually instead.
G2A_GMAIL=
G2A_PASSWORD=

# Optional, used by the auto-fill path in scripts/g2g-login.ts. Set both to
# skip manual login — npm run login:g2g will fill and submit G2G's login
# form for you (you may still need to solve a CAPTCHA/2FA prompt by hand).
# Leave both unset to log in manually instead.
G2G_GMAIL=
G2G_PASSWORD=
