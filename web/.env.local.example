# Same Supabase project as the Telegram bot (../ .env)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: lets admin actions (approve/reject/deliver) on a Telegram-
# originated order notify the buyer back on Telegram. Same bot token as the
# bot's .env. Leave blank if you only care about the web channel.
BOT_TOKEN=

# Flat USD markup over the scraped G2G price — keep this the same value as
# the bot's CATALOG_MARKUP_USD so prices match across both channels.
CATALOG_MARKUP_USD=1

# Shown on the checkout page under the QR code.
PAYMENT_INSTRUCTIONS="Transfer to Bank XXX, Account Name: Your Name, Account No: 000-000-000"
