{
  "name": "cambo-market",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram middleman bot & Next.js storefront",
  "scripts": {
    "dev": "concurrently -n web,bot -c green,blue \"next dev\" \"tsx watch src/bot/index.ts\"",
    "build": "next build",
    "bot": "tsx watch src/bot/index.ts",
    "start": "concurrently -n web,bot -c green,blue \"next start\" \"tsx src/bot/index.ts\"",
    "lint": "next lint"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "cheerio": "^1.0.0",
    "devalue": "^5.9.1",
    "dotenv": "^16.4.5",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "telegraf": "^4.16.3",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2"
  }
}
