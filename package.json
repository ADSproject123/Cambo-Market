{
  "name": "cheap-staff-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram middleman bot for buying G2A/G2G listings via manual admin fulfillment",
  "scripts": {
    "dev": "concurrently -n bot,web -c blue,green \"npm:dev:bot\" \"npm:dev:web\"",
    "dev:bot": "tsx watch src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cheerio": "^1.0.0",
    "devalue": "^5.9.1",
    "dotenv": "^16.4.5",
    "telegraf": "^4.16.3",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "concurrently": "^10.0.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
